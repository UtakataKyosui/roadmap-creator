{
  "name": "tanstack-start-example-basic",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --noEmit",
    "preview": "vp preview",
    "prepare": "vp config",
    "void": "void",
    "void:connect": "void connect",
    "void:deploy": "vp build && void deploy",
    "stitch": "stitch",
    "test": "vp test --config vitest.config.ts",
    "api:generate": "orval",
    "api:lint": "redocly lint openapi/openapi.yaml",
    "api:check": "orval && git add -N src/api/generated && git diff --exit-code -- src/api/generated",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:seed": "void db seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/stitch": "^0.11.1",
    "@redocly/cli": "^2.65.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260903-beta",
    "orval": "^8.43.0",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "^1.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
