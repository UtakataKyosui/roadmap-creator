{
  "name": "roadmapper",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && tsc --noEmit",
    "preview": "vp preview",
    "prepare": "vp config",
    "void": "void",
    "void:connect": "void connect",
    "verify": "vp check && vp run api:lint && vp run api:check && vp run test --run && vp run build",
    "void:deploy": "vp run verify && void deploy --platform cloudflare",
    "stitch": "stitch",
    "test": "vp test --config vitest.config.ts",
    "api:generate": "orval",
    "api:lint": "redocly lint openapi/openapi.yaml",
    "api:check": "orval && node scripts/check-generated.mjs",
    "db:generate": "void db generate",
    "db:migrate": "void db migrate",
    "db:seed": "void db seed",
    "void:secret:put": "void secret sync .env"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@roadmapper/api-contract": "workspace:*",
    "@roadmapper/domain": "workspace:*",
    "@roadmapper/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "0.45.4",
    "effect": "^3.22.3",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/stitch": "^0.11.1",
    "@redocly/cli": "^2.65.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260903-beta",
    "orval": "^8.43.0",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "void": "^1.1.12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
