# ローカル開発用の環境変数のテンプレート。`cp env.example .env` で `.env` を作る。
# SSR 中にアプリ自身の API を呼ぶときのオリジン。
API_ORIGIN=http://localhost:3000
# セッション署名用の秘密鍵。`openssl rand -base64 32` などで生成した32文字以上の値を設定する。
BETTER_AUTH_SECRET=
# Google Cloud ConsoleのOAuthクライアント。承認済みのリダイレクトURIに
# `${API_ORIGIN}/api/auth/callback/google` を登録する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
